<Project Sdk="Microsoft.NET.Sdk">
  <!-- Structure follows the Command Palette extension template from microsoft/PowerToys (MIT). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Recall.CmdPal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsSdkPackageVersion>10.0.26100.68-preview</WindowsSdkPackageVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!-- Only the pipe contract and two dependency-free helpers are shared with the core: no SQLite or document libraries in the package. -->
  <ItemGroup>
    <Compile Include="..\Recall.Core\Ipc\Protocol.cs" Link="Ipc\Protocol.cs" />
    <Compile Include="..\Recall.Core\Ipc\PipeClient.cs" Link="Ipc\PipeClient.cs" />
    <Compile Include="..\Recall.Core\Ipc\ListDiff.cs" Link="Ipc\ListDiff.cs" />
    <Compile Include="..\Recall.Core\Ignore\BuiltInRules.cs" Link="Ignore\BuiltInRules.cs" />
    <Compile Include="..\Recall.Core\Search\QueryParser.cs" Link="Search\QueryParser.cs" />
    <Compile Include="..\Recall.Core\Search\MarkdownHighlight.cs" Link="Search\MarkdownHighlight.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" Version="0.11.260520004" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Shmuelie.WinRTServer" Version="2.1.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.251221100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
